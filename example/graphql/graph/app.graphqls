extend type Query {
  """
  The published posts, composed by the application from its own query with
  gen.PostsConnectionOf: paged, ordered and filtered as the posts connection
  is.
  """
  publishedPosts(
    after: Cursor
    first: Int
    before: Cursor
    last: Int
    orderBy: [PostOrder!]
    where: PostWhereInput
  ): PostConnection!
}
