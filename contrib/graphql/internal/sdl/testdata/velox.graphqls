# The vocabulary of velox's GraphQL types: the scalars, Node, PageInfo and
# OrderDirection, bound to Go by contrib/graphql/veloxgql, and gqlgen's @goField
# and @goModel, as gqlgen documents them.

"""A time, as an RFC 3339 string."""
scalar Time

"""A UUID, as a string."""
scalar UUID

"""Bytes, as a base64 string."""
scalar Bytes

"""A JSON value."""
scalar JSON

"""An unsigned 64-bit integer, as a decimal string."""
scalar Uint64

"""An opaque cursor for paging through a connection."""
scalar Cursor

directive @goField(forceResolver: Boolean, name: String, omittable: Boolean, type: String) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

directive @goModel(model: String, models: [String!], forceGenerate: Boolean) on OBJECT | INPUT_OBJECT | SCALAR | ENUM | INTERFACE | UNION

"""An object with a global ID."""
interface Node {
  """The global ID of the object."""
  id: ID!
}

"""Information about a page of a connection."""
type PageInfo {
  """Whether there are more nodes after this page."""
  hasNextPage: Boolean!
  """Whether there are more nodes before this page."""
  hasPreviousPage: Boolean!
  """The cursor of the first node of the page."""
  startCursor: Cursor
  """The cursor of the last node of the page."""
  endCursor: Cursor
}

"""The direction of an order."""
enum OrderDirection {
  ASC
  DESC
}

# The root query.

type Query {
  """The node with this ID, or null."""
  node(id: ID!): Node
  """The nodes with these IDs, in their order; null for an ID with no node."""
  nodes(ids: [ID!]!): [Node]!
  categories(after: Cursor, first: Int, before: Cursor, last: Int, where: CategoryWhereInput): CategoryConnection!
  groups(after: Cursor, first: Int, before: Cursor, last: Int, orderBy: GroupOrder): GroupConnection!
  posts(after: Cursor, first: Int, before: Cursor, last: Int, orderBy: [PostOrder!], where: PostWhereInput): PostConnection!
  accounts(after: Cursor, first: Int, before: Cursor, last: Int, where: AccountWhereInput): AccountConnection!
}

# The root mutation.

type Mutation {
  """Creates one Category."""
  createCategory(input: CreateCategoryInput!): Category!
  """Updates the Category with this ID: only the fields given change."""
  updateCategory(id: ID!, input: UpdateCategoryInput!): Category!
  """Creates one Like."""
  createLike(input: CreateLikeInput!): Like!
  """Creates one Post."""
  createPost(input: CreatePostInput!): Post!
  """Updates the Post with this ID: only the fields given change."""
  updatePost(id: ID!, input: UpdatePostInput!): Post!
  """Deletes the Post with this ID, and returns the ID."""
  deletePost(id: ID!): ID!
  """Creates one Account."""
  createAccount(input: CreateAccountInput!): Account!
}

# Category

"""A category of posts, in a tree."""
type Category implements Node {
  id: ID! @goField(name: "IDGQL")
  title: String!
  """The subcategories."""
  children(after: Cursor, first: Int, before: Cursor, last: Int, where: CategoryWhereInput): CategoryConnection! @goField(name: "ChildrenGQL")
  parent: Category @goField(name: "ParentGQL")
}

"""A connection to a list of Category."""
type CategoryConnection {
  """The edges of this page."""
  edges: [CategoryEdge!]!
  """Information about this page."""
  pageInfo: PageInfo!
  """The number of nodes in the whole connection, not only on this page."""
  totalCount: Int!
}

"""An edge in a connection to a list of Category."""
type CategoryEdge {
  """The Category at the end of the edge."""
  node: Category!
  """The cursor of this edge, for paging."""
  cursor: Cursor!
}

"""Filters Category nodes: a node matches when every predicate given holds."""
input CategoryWhereInput {
  not: CategoryWhereInput
  and: [CategoryWhereInput!]
  or: [CategoryWhereInput!]
  id: ID
  idNEQ: ID
  idIn: [ID!]
  idNotIn: [ID!]
  idGT: ID
  idGTE: ID
  idLT: ID
  idLTE: ID
  hasParent: Boolean
  hasParentWith: [CategoryWhereInput!]
}

"""The input of createCategory."""
input CreateCategoryInput {
  title: String!
  childIDs: [ID!]
  parentID: ID
}

"""The input of updateCategory: a field not given is left as it is."""
input UpdateCategoryInput {
  title: String
  addChildIDs: [ID!]
  removeChildIDs: [ID!]
  clearChildren: Boolean
  parentID: ID
  clearParent: Boolean
}

# Group

type Group implements Node {
  id: ID! @goField(name: "IDGQL")
  name: String!
  """Who can see the group; a String, as its enum is skipped."""
  visibility: String!
  users(after: Cursor, first: Int, before: Cursor, last: Int, where: AccountWhereInput): AccountConnection! @goField(name: "UsersGQL")
}

"""A connection to a list of Group."""
type GroupConnection {
  """The edges of this page."""
  edges: [GroupEdge!]!
  """Information about this page."""
  pageInfo: PageInfo!
  """The number of nodes in the whole connection, not only on this page."""
  totalCount: Int!
}

"""An edge in a connection to a list of Group."""
type GroupEdge {
  """The Group at the end of the edge."""
  node: Group!
  """The cursor of this edge, for paging."""
  cursor: Cursor!
}

"""Ordering options for connections to Group."""
input GroupOrder {
  """The direction of the order."""
  direction: OrderDirection! = ASC
  """The field to order by."""
  field: GroupOrderField!
}

"""The fields connections to Group can be ordered by."""
enum GroupOrderField {
  NAME
}

# Like

"""A user's like of a post. Its key is two columns, so it is not a Node."""
type Like {
  weight: Int!
  createdAt: Time!
  user: Account! @goField(name: "UserGQL")
  post: Post! @goField(name: "PostGQL")
}

"""A connection to a list of Like."""
type LikeConnection {
  """The edges of this page."""
  edges: [LikeEdge!]!
  """Information about this page."""
  pageInfo: PageInfo!
  """The number of nodes in the whole connection, not only on this page."""
  totalCount: Int!
}

"""An edge in a connection to a list of Like."""
type LikeEdge {
  """The Like at the end of the edge."""
  node: Like!
  """The cursor of this edge, for paging."""
  cursor: Cursor!
}

"""The input of createLike."""
input CreateLikeInput {
  weight: Int
  createdAt: Time
  userID: ID!
  postID: ID!
}

# Post

type Post implements Node {
  id: ID! @goField(name: "IDGQL")
  title: String!
  slug: String!
  status: PostStatus!
  publishedAt: Time
  tags: JSON! @goField(name: "TagsGQL")
  views: Int!
  rating: Float
  """Who last edited the post; the update default fills it."""
  editedBy: String!
  """The user who wrote the post."""
  writer: Account! @goField(name: "AuthorGQL")
  likes: [Like!]! @goField(name: "LikesGQL")
  """Posts this post links to; a join of Post to itself."""
  related(after: Cursor, first: Int, before: Cursor, last: Int, orderBy: [PostOrder!], where: PostWhereInput): PostConnection! @goField(name: "RelatedGQL")
  relatedBy(after: Cursor, first: Int, before: Cursor, last: Int, orderBy: [PostOrder!], where: PostWhereInput): PostConnection! @goField(name: "RelatedByGQL")
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  LIVE
}

"""A connection to a list of Post."""
type PostConnection {
  """The edges of this page."""
  edges: [PostEdge!]!
  """Information about this page."""
  pageInfo: PageInfo!
  """The number of nodes in the whole connection, not only on this page."""
  totalCount: Int!
}

"""An edge in a connection to a list of Post."""
type PostEdge {
  """The Post at the end of the edge."""
  node: Post!
  """The cursor of this edge, for paging."""
  cursor: Cursor!
}

"""Ordering options for connections to Post."""
input PostOrder {
  """The direction of the order."""
  direction: OrderDirection! = ASC
  """The field to order by."""
  field: PostOrderField!
}

"""The fields connections to Post can be ordered by."""
enum PostOrderField {
  TITLE
  VIEWS
}

"""Filters Post nodes: a node matches when every predicate given holds."""
input PostWhereInput {
  not: PostWhereInput
  and: [PostWhereInput!]
  or: [PostWhereInput!]
  id: ID
  idNEQ: ID
  idIn: [ID!]
  idNotIn: [ID!]
  idGT: ID
  idGTE: ID
  idLT: ID
  idLTE: ID
  writerID: ID
  writerIDNEQ: ID
  writerIDIn: [ID!]
  writerIDNotIn: [ID!]
  title: String
  titleNEQ: String
  titleIn: [String!]
  titleNotIn: [String!]
  titleContains: String
  titleHasPrefix: String
  titleHasSuffix: String
  slug: String
  slugNEQ: String
  slugIn: [String!]
  slugNotIn: [String!]
  status: PostStatus
  statusNEQ: PostStatus
  statusIn: [PostStatus!]
  statusNotIn: [PostStatus!]
  publishedAt: Time
  publishedAtNEQ: Time
  publishedAtIn: [Time!]
  publishedAtNotIn: [Time!]
  publishedAtGT: Time
  publishedAtGTE: Time
  publishedAtLT: Time
  publishedAtLTE: Time
  publishedAtIsNil: Boolean
  publishedAtNotNil: Boolean
  hasWriter: Boolean
  hasWriterWith: [AccountWhereInput!]
}

"""The input of createPost."""
input CreatePostInput {
  title: String!
  slug: String!
  status: PostStatus
  publishedAt: Time
  tags: JSON
  rating: Float
  """Who last edited the post; the update default fills it."""
  editedBy: String!
  writerID: ID!
  relatedIDs: [ID!]
  relatedByIDs: [ID!]
}

"""The input of updatePost: a field not given is left as it is."""
input UpdatePostInput {
  title: String
  status: PostStatus
  publishedAt: Time
  clearPublishedAt: Boolean
  tags: JSON
  views: Int
  rating: Float
  clearRating: Boolean
  writerID: ID
  addRelatedIDs: [ID!]
  removeRelatedIDs: [ID!]
  clearRelated: Boolean
  addRelatedByIDs: [ID!]
  removeRelatedByIDs: [ID!]
  clearRelatedBy: Boolean
}

# User, as the type Account

"""
User is a person who writes posts.
Its GraphQL type is Account.
"""
type Account implements Node {
  id: ID! @goField(name: "IDGQL")
  createdAt: Time!
  updatedAt: Time!
  """The display name."""
  displayName: String! @goField(name: "Name")
  email: String!
  role: UserRole!
  nickname: String @deprecated(reason: "Use \"displayName\".")
  bio: String
  age: Int
  score: Float!
  externalID: UUID!
  avatar: Bytes
  quota: Uint64!
  active: Boolean!
  settings: JSON @goField(name: "SettingsGQL")
  """The posts the user wrote."""
  posts(after: Cursor, first: Int, before: Cursor, last: Int, orderBy: [PostOrder!], where: PostWhereInput): PostConnection! @goField(name: "PostsGQL") @cost(meta: {cached: true, ttl: null}, tags: ["list", "paged"], weight: 2.5)
  memberships: [Group!]! @goField(name: "GroupsGQL")
  likes(after: Cursor, first: Int, before: Cursor, last: Int): LikeConnection! @goField(name: "LikesGQL")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

"""A connection to a list of Account."""
type AccountConnection {
  """The edges of this page."""
  edges: [AccountEdge!]!
  """Information about this page."""
  pageInfo: PageInfo!
  """The number of nodes in the whole connection, not only on this page."""
  totalCount: Int!
}

"""An edge in a connection to a list of Account."""
type AccountEdge {
  """The Account at the end of the edge."""
  node: Account!
  """The cursor of this edge, for paging."""
  cursor: Cursor!
}

"""Filters Account nodes: a node matches when every predicate given holds."""
input AccountWhereInput {
  not: AccountWhereInput
  and: [AccountWhereInput!]
  or: [AccountWhereInput!]
  id: ID
  idNEQ: ID
  idIn: [ID!]
  idNotIn: [ID!]
  idGT: ID
  idGTE: ID
  idLT: ID
  idLTE: ID
  displayName: String
  displayNameNEQ: String
  displayNameIn: [String!]
  displayNameNotIn: [String!]
  displayNameContains: String
  displayNameHasPrefix: String
  displayNameHasSuffix: String
  hasPosts: Boolean @cost(meta: {cached: true, ttl: null}, tags: ["list", "paged"], weight: 2.5)
  hasPostsWith: [PostWhereInput!] @cost(meta: {cached: true, ttl: null}, tags: ["list", "paged"], weight: 2.5)
}

"""The input of createAccount."""
input CreateAccountInput {
  createdAt: Time
  updatedAt: Time
  """The display name."""
  displayName: String!
  email: String!
  role: UserRole
  nickname: String @deprecated(reason: "Use \"displayName\".")
  bio: String
  age: Int
  passwordHash: String!
  score: Float
  externalID: UUID
  avatar: Bytes
  quota: Uint64!
  active: Boolean
  settings: JSON
  membershipIDs: [ID!]
  bestFriendID: ID
}
