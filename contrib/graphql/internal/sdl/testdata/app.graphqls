# The application's own schema file, which gqlgen loads beside
# gen/velox.graphqls: it declares the directives the test model's annotations
# use, and extends the Query.

directive @key(fields: String!) on OBJECT
directive @cost(weight: Float, tags: [String!], meta: CostMeta) on FIELD_DEFINITION

input CostMeta {
  cached: Boolean
  ttl: Int
}

extend type Query {
  me: Account
}
