package app

import (
	"context"
	"fmt"
	"sync/atomic"
	"testing"

	"github.com/syssam/velox/contrib/graphql/gqlinput"
	"github.com/syssam/velox/tests/orm/velox"
	"github.com/syssam/velox/tests/orm/velox/entity"
	"github.com/syssam/velox/tests/orm/velox/migrate"
	"github.com/syssam/velox/tests/orm/velox/post"
	"github.com/syssam/velox/tests/orm/velox/user"

	_ "modernc.org/sqlite"
)

// byNameDesc is the order input "by name, descending", of an entity that
// takes a list of orders.
func byNameDesc(*testing.T) []*entity.UserOrder {
	return []*entity.UserOrder{{Field: user.OrderFieldName, Direction: gqlinput.OrderDirectionDesc}}
}

// withHandle is what a server does once per request where edges are resolved
// from entities: it puts the handle in the context.
func withHandle(ctx context.Context, s *Store) context.Context {
	return velox.WithExecutor(ctx, s.Client)
}

// descending is the direction of an order input.
const descending = gqlinput.OrderDirectionDesc

var seq atomic.Int64

// This file is the part of the tests the tool does not migrate: how a
// database is opened is the application's own, and an order input is what a
// GraphQL engine hands over.

// byTitle is the order input "by title, ascending".
func byTitle(*testing.T) *entity.PostOrder {
	return &entity.PostOrder{Field: post.OrderFieldTitle, Direction: gqlinput.OrderDirectionAsc}
}

func open(t *testing.T) *Store {
	t.Helper()
	conn, err := velox.Open("sqlite", fmt.Sprintf("file:apporm%d?mode=memory&cache=shared&_pragma=foreign_keys(1)", seq.Add(1)))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = conn.Close() })
	if err := migrate.Create(context.Background(), conn); err != nil {
		t.Fatal(err)
	}
	return &Store{Client: conn}
}
